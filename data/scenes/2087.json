  "chapters": [
    {
      "chapter_index": 0,
      "chapter_id": 16009,
      "title": "凯旋的远征者",
      "summary": "洛恩返回蒙德递送法尔伽的信，旅行者在协助送信的过程中了解到北风骑士的传承、罗兰由纯白走向染血的往事，以及法尔伽维系同伴关系的用心。奔狼领突然遭狂猎袭击，玻瑞亚斯确认挪德卡莱的安德留斯孑遗已受侵蚀，并把狼灵信物托付给旅行者。旅行者随即乘特瓦林赶赴挪德卡莱，加入法尔伽与罗兰倒影的战场。",
      "turning_point": "奔狼领的狂猎袭击打破了远征即将结束的预期，玻瑞亚斯揭示北方安德留斯的孑遗才是新动乱的根源。",
      "outcome": "旅行者携带玻瑞亚斯的狼灵信物抵达挪德卡莱，与法尔伽会合，并确认远征军在凯旋前仍须解决无法轻易杀死的受控魔神。",
      "section_ids": [
        "2087-c00-s01",
        "2087-c00-s02",
        "2087-c00-s03",
        "2087-c00-s04",
        "2087-c00-s05",
        "2087-c00-s06"
      ],
      "context_ref_ids": [],
      "source_file": "chapter_00.json",
      "source_description": "在众人的奋战之下，北方的深渊灾厄似乎已经平定…\\n凯旋之期，已在近前。",
      "is_hidden": false
    },
    {
      "chapter_index": 1,
      "chapter_id": 16010,
      "title": "命运的远征者",
      "summary": "法尔伽召集盟友确认敌人是深渊以罗兰记忆制造的倒影，并提出以玻瑞亚斯的狼灵唤醒安德留斯、让其主动归于地脉的方案。旅行者协助收集狼灵碎片，并从受侵蚀的记忆中查明罗兰因视坎瑞亚遭遇为最大不公而投效深渊。远征军与执灯人突破狂猎的连续阻击，最终收齐碎片，但罗兰倒影识破表面计划，在决斗中击碎法尔伽的佩剑并将他逼入绝境。",
      "turning_point": "罗兰倒影击碎了承载狼灵的佩剑，宣告法尔伽公开展现的方案失败，却也使其隐藏计划进入真正的执行阶段。",
      "outcome": "法尔伽与罗兰倒影一同进入北风的意识空间，计划的成败转而取决于他能否唤醒安德留斯并从狼灵同化中返回。",
      "section_ids": [
        "2087-c01-s01",
        "2087-c01-s02",
        "2087-c01-s03",
        "2087-c01-s04",
        "2087-c01-s05"
      ],
      "context_ref_ids": [],
      "source_file": "chapter_01.json",
      "source_description": "水占盘里倒映出未来的幻景，狼灵之中寄宿着往昔的追忆…\\n命运之数，变幻无常。",
      "is_hidden": false
    },
    {
      "chapter_index": 2,
      "chapter_id": 16011,
      "title": "孤独的远征者",
      "summary": "法尔伽在北风与罗兰意识交织的空间中独自深入，并直面承认自身并不完整、却仍坚持深渊正义的罗兰倒影。他揭露佩剑只是佯攻，真正的狼灵早由自己的心脏承载，从而将玻瑞亚斯的记忆送入安德留斯心中，使魔神主动归于地脉。尽管法尔伽也险些随之消散，旅行者、温迪以及蒙德众人寄托在书信中的思念最终将他引回现实，迎来真正的凯旋。",
      "turning_point": "安德留斯从玻瑞亚斯的记忆中重新确认归于地脉的选择，而法尔伽揭示自己以心脏承载狼灵的真正计划。",
      "outcome": "罗兰倒影与狂猎反扑被终结，法尔伽平安回到蒙德，远征军开始分批凯旋并保留北方据点。",
      "section_ids": [
        "2087-c02-s01",
        "2087-c02-s02",
        "2087-c02-s03"
      ],
      "context_ref_ids": [],
      "source_file": "chapter_02.json",
      "source_description": "来时纵有千军万马，末路亦不免孤军奋战…\\n孤独之人，请上前来。",
      "is_hidden": false
    }
  ],
