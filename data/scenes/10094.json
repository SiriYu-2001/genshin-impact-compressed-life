    {
      "id": "10094-c04-s07",
      "chapter_index": 4,
      "order": 7,
      "title": "半截天阶留下登顶可能",
      "narrative_role": "revelation",
      "importance": 5,
      "when": "离开图书馆后",
      "locations": [
        "「大方广之间」出口区域"
      ],
      "characters": [
        "旅行者",
        "派蒙",
        "彩特琳德",
        "伊斯托利亚"
